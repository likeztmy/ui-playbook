{
  "name": "ui-playbook",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/build-tokens.mjs && astro check && pnpm -s lint",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm build && pnpm test:e2e",
    "shoot": "node scripts/shoot.mjs",
    "deploy": "pnpm verify && wrangler deploy",
    "astro": "astro",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "stylelint \"src/**/*.scss\" && node scripts/lint-svg.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.106.0",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
