---
// Each direction's home page head, on the same title and line.
import s from './Directions.module.scss';

interface Props {
  direction: 'workbench' | 'field';
}
const { direction } = Astro.props;

// Dials around the title, as on dialkit.dev. Each is a real setting of the canvas below it:
// a press steps to the next value (lab.ts).
const dials = [
  { dial: 'palette', label: 'Palette', value: 'Blue', x: '4%', y: '20%', r: -6 },
  { dial: 'theme', label: 'Theme', value: 'Light', x: '76%', y: '10%', r: 5 },
  { dial: 'corners', label: 'Corners', value: 'Default', x: '78%', y: '72%', r: -4 },
  { dial: 'motion', label: 'Motion', value: 'On', x: '2%', y: '76%', r: 4 },
];
---

{
  direction === 'workbench' && (
    <div class={s.bench}>
      {dials.map((d) => (
        <button type="button" class={s.chip} data-dial={d.dial} style={`left: ${d.x}; top: ${d.y}; rotate: ${d.r}deg`}>
          <span>{d.label}</span>
          <code>{d.value}</code>
        </button>
      ))}
      <h1 class={s.benchTitle}>UI Playbook</h1>
      <p class={s.benchLine}>The small details that make interface components feel right, each one shown side by side.</p>
    </div>
  )
}

{
  direction === 'field' && (
    <div class={s.field}>
      <h1 class={s.fieldTitle}>UI Playbook</h1>
      <p class={s.fieldLine}>The small details that make interface components feel right, each one shown side by side.</p>
      <div class={s.fieldSearch}>
        <span>Search the playbook</span>
        <kbd data-mark="circle">/</kbd>
      </div>
      <span class={s.hand} style="left: 62%; top: 56%">
        <svg viewBox="0 0 60 40" width="48" height="32" aria-hidden="true" data-arrow="56,6 40,4 20,14 8,30" data-head="4,22 8,31 17,28">
          <path d="M56 6 C 40 4, 20 14, 8 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M4 22 L 8 31 L 17 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        type a component, or a feeling
      </span>
    </div>
  )
}
