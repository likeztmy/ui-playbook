---
// One part of a look's page, from its data: a link to it on the screens, the values with their
// sources, or the block to paste.
import { Code } from 'astro:components';
import { codeThemes, codeTransformers } from '../../styles/code.mjs';
import { lookById, rootBlock, valuesOf } from '../../looks';
import s from './Look.module.scss';

type Props = { id: string; part: 'specimen' | 'values' | 'code' };
const { id, part } = Astro.props;
const look = lookById(id);
const values = valuesOf(look);
const colour = (v: string) => /^#|^rgb|^oklch|^color-mix/.test(v);
const ours = values.filter(([, v]) => !v.from).length;
// A value wraps only between its words, never inside one: "-apple-system" stays whole.
const words = (v: string) => v.split(' ');
---

{part === 'specimen' && <p class={s.desk}><a href={`/systems/looks?look=${id}`}>See it on the screens</a></p>}

{
  part === 'values' && (
    <>
      <p>
        Type: <strong>{look.font.name}</strong>. {look.font.licence} (<a href={look.font.from.href}>{look.font.from.label}</a>)
        {id !== 'playbook' && (
          <>
            {' '}
            {values.length - ours} of {values.length} values are the product’s own; the other {ours} are the playbook’s.
          </>
        )}
      </p>
      <table class={s.table}>
        <thead>
          <tr>
            <th>Variable</th>
            <th>Light</th>
            <th>Dark</th>
            <th>From</th>
          </tr>
        </thead>
        <tbody>
          {values.map(([name, v]) => (
            <tr>
              <td>
                <code>--{name}</code>
              </td>
              {(['light', 'dark'] as const).map((t) => (
                <td>
                  {colour(v[t]) && <span class={s.chip} style={`background:${v[t]}`} aria-hidden="true" />}
                  <code class={s.value}>
                    {words(v[t]).map((w, k) => (
                      <>
                        {k > 0 && ' '}
                        <span class={s.word}>{w}</span>
                      </>
                    ))}
                  </code>
                </td>
              ))}
              <td>
                {v.from ? <a href={v.from.href}>{v.from.label}</a> : 'Playbook'}
                {v.note && <span class={s.note}>{' '}{v.note}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )
}

{
  part === 'code' && (
    <Code
      code={rootBlock(look)}
      lang="css"
      themes={codeThemes}
      defaultColor={false}
      transformers={codeTransformers}
      role="region"
      aria-label={`CSS variables for ${look.name}`}
    />
  )
}
