---
// The home head, on the gallery's left edge: the title, a line, and the search field, with a
// hand-written note at its shortcut. The search itself is wired in Home.astro.
import { SearchIcon } from '../ui/icons';
import { ui, type Lang } from '../i18n';
import Note from './note/Note.astro';
import s from './Hero.module.scss';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = ui[lang];
---

<section class={s.hero}>
  <h1 class={s.title}>UI Playbook</h1>
  <p class={s.lede}>{t.lede}</p>
  <Note text={t.searchNote} to="kbd" at="left: calc(100% + 72px); top: 36px">
    <label class={s.search}>
      <SearchIcon />
      <input id="search" type="search" placeholder={t.search} autocomplete="off" spellcheck="false" />
      <kbd class={s.key} aria-hidden="true">/</kbd>
    </label>
  </Note>
</section>
