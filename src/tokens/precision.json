    "tokens": [
      {
        "name": "bg",
        "value": {
          "light": "#f7f7f8",
          "dark": "#0e0f11"
        },
        "usage": "应用最底层背景：窗口、侧栏外的画布。"
      },
      {
        "name": "surface",
        "value": {
          "light": "#ffffff",
          "dark": "#16171a"
        },
        "usage": "面板、卡片、输入框底色。正文 `ink` 与 `ink-muted` 落在它上面。"
      },
      {
        "name": "surface-raised",
        "value": {
          "light": "#ffffff",
          "dark": "#1e1f23"
        },
        "usage": "浮层：菜单、弹出框、对话框。深色模式靠更亮的表面表达更高层级，浅色模式靠阴影。"
      },
      {
        "name": "surface-sunken",
        "value": {
          "light": "#efeff1",
          "dark": "#0a0b0c"
        },
        "usage": "凹陷的轨道：分段控件底槽、代码块、只读区域。"
      },
      {
        "name": "line",
        "value": {
          "light": "#e4e4e8",
          "dark": "#26272c"
        },
        "usage": "表格分隔线、分组分隔线。纯装饰，不承载含义。"
      },
      {
        "name": "line-strong",
        "value": {
          "light": "#868690",
          "dark": "#6c6d76"
        },
        "usage": "输入框、下拉触发器、复选框的边框（≥3:1）。这是\"用填充代替描边\"的唯一例外：空输入框没有文字，只有边框能告诉人这里可以输入。"
      },
      {
        "name": "ink",
        "value": {
          "light": "#18181b",
          "dark": "#ececef"
        },
        "usage": "主文本与图标，用于 `bg`、`surface`、`surface-raised`、`surface-sunken`、`accent-soft` 之上。"
      },
      {
        "name": "ink-muted",
        "value": {
          "light": "#5e5e67",
          "dark": "#b4b4bd"
        },
        "usage": "次要文本、说明、占位符，用于所有表面以及叠了两层 `fill-control` 的区域（Slider 填充）之上，两种主题下 ≥4.5:1。"
      },
      {
        "name": "ink-disabled",
        "value": {
          "light": "#a8a8b0",
          "dark": "#4a4b52"
        },
        "usage": "仅用于禁用态文字与图标，不用于任何需要阅读的内容。"
      },
      {
        "name": "fill-hover",
        "value": {
          "light": "#18181b0d",
          "dark": "#ffffff0f"
        },
        "usage": "中性控件与列表项的悬停叠加层。"
      },
      {
        "name": "fill-active",
        "value": {
          "light": "#18181b17",
          "dark": "#ffffff1a"
        },
        "usage": "中性控件按下态叠加层。"
      },
      {
        "name": "fill-control",
        "value": {
          "light": "#18181b0f",
          "dark": "#ffffff17"
        },
        "usage": "次要按钮、图标按钮、筛选胶囊的静止底色。用填充而不是描边来表示\"这是一个控件\"，文字 `ink`。"
      },
      {
        "name": "fill-control-hover",
        "value": {
          "light": "#18181b1a",
          "dark": "#ffffff21"
        },
        "usage": "`fill-control` 的悬停与按下态。"
      },
      {
        "name": "accent",
        "value": {
          "light": "#0071e3",
          "dark": "#0071e3"
        },
        "usage": "Apple 系统蓝，唯一的强调色：主按钮填充、选中块、焦点环、输入框聚焦边框。作为文字请用 `accent-text`。每个视图主按钮最多一个。"
      },
      {
        "name": "accent-hover",
        "value": {
          "light": "#0066cc",
          "dark": "#0066cc"
        },
        "usage": "主按钮悬停与按下填充。"
      },
      {
        "name": "on-accent",
        "value": {
          "light": "#ffffff",
          "dark": "#ffffff"
        },
        "usage": "`accent` 与 `accent-hover` 填充上的文字和图标：两种主题都是白字（4.7:1）。深色模式的主色压暗到与浅色相同，而不是提亮配深色字：提亮后深色字 WCAG 过线，APCA 却只有 Lc 40。"
      },
      {
        "name": "accent-soft",
        "value": {
          "light": "#e8f2ff",
          "dark": "#0b2747"
        },
        "usage": "选中行、选中工具的浅底；文字用 `ink` 或 `accent-text`。"
      },
      {
        "name": "accent-text",
        "value": {
          "light": "#0066cc",
          "dark": "#7dbbff"
        },
        "usage": "蓝色文字：链接、选中工具的图标、强调文字。用于所有表面与 `accent-soft` 之上（≥4.8:1）。#007aff / #0a84ff 直接当文字用对比度不够，所以文字单独一档。"
      },
      {
        "name": "danger",
        "value": {
          "light": "#a11f01",
          "dark": "#ff9c7d"
        },
        "usage": "破坏性操作与错误。始终配合图标或文字出现，不单靠颜色。"
      },
      {
        "name": "danger-soft",
        "value": {
          "light": "#fdeee8",
          "dark": "#3a1a10"
        },
        "usage": "错误提示的浅底，文字用 `danger`。"
      },
      {
        "name": "on-danger",
        "value": {
          "light": "#ffffff",
          "dark": "#0e0f11"
        },
        "usage": "危险填充上的文字。暗色里 `danger` 是亮色，配白字看不清，所以用近黑。"
      },
      {
        "name": "success",
        "value": {
          "light": "#127a5a",
          "dark": "#54cc9e"
        },
        "usage": "成功与完成状态。始终配合图标或文字出现，不单靠颜色与 `danger` 区分。"
      },
      {
        "name": "success-soft",
        "value": {
          "light": "#e6f4ee",
          "dark": "#0f2e23"
        },
        "usage": "成功提示的浅底，文字用 `success`。"
      },
      {
        "name": "warning",
        "value": {
          "light": "#9d5e02",
          "dark": "#eeaa3b"
        },
        "usage": "需要注意但不阻断的状态：配额将满、未保存的修改。作为文字用于所有表面与 `warning-soft` 之上。比 `danger` 亮一截（OKLCH L 54% 对 46%），红绿色弱也分得开；仍配图标或文字。"
      },
      {
        "name": "warning-soft",
        "value": {
          "light": "#fdf3e1",
          "dark": "#33250a"
        },
        "usage": "警告提示的浅底，文字用 `warning`。"
      },
      {
        "name": "info",
        "value": "{accent-text}",
        "usage": "中性提示（新功能、说明）。`accent-text` 的别名，保证信息色和链接是同一种蓝。"
      },
      {
        "name": "info-soft",
        "value": "{accent-soft}",
        "usage": "信息提示的浅底，`accent-soft` 的别名。"
      },
      {
        "name": "scrim",
        "value": {
          "light": "#18181b52",
          "dark": "#000000a3"
        },
        "usage": "对话框背后的遮罩，盖住整个视口。"
      },
      {
        "name": "knob",
        "value": {
          "light": "#ffffff",
          "dark": "#f4f4f6"
        },
        "usage": "开关的滑块。在 `line-strong`（关）和 `accent`（开）上都保持清晰。"
      }
    ],
