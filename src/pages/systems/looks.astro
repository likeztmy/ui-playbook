---
// A tool page, not an article: a toolbar for the look, and Ship filling the rest of the window.
// It needs a desk; on a phone the page points to each look's own page instead.
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/look/Gallery.astro';
import { entries } from '../../entries';
import s from './looks.module.scss';

const entry = entries.find((e) => e.slug === 'looks')!;
---

<Base title={entry.title} description={entry.summary} wide>
  <div class={s.desk}>
    <Gallery />
  </div>
  <div class={s.phone}>
    <h1 class={s.title}>Looks</h1>
    <p class={s.notice}>
      The looks need a wider window. Each one’s values are on its own page:{' '}
      <a href="/systems/look-playbook">Playbook</a>,{' '}<a href="/systems/look-primer">After Primer</a>,{' '}<a href="/systems/look-linear">After Linear</a>.
    </p>
  </div>
</Base>
