---
import Base from '../../layouts/Base.astro';
import Heads from '../../components/directions/Heads.astro';
import Opening from '../../components/directions/Opening.astro';
import s from '../../components/directions/Directions.module.scss';

// Two directions on the same real content: the home page's head and one principle page's opening.
// The pickers set the title face and the note's hand for both; body text stays Geist.
const faces = [
  { id: 'jetbrains', name: 'JetBrains Mono' },
  { id: 'quattro', name: 'iA Writer Quattro' },
  { id: 'recursive', name: 'Recursive' },
  { id: 'grotesk', name: 'Space Grotesk' },
  { id: 'bricolage', name: 'Bricolage Grotesque' },
  { id: 'host', name: 'Host Grotesk' },
  { id: 'mona', name: 'Mona Sans' },
  { id: 'geist', name: 'Geist' },
  { id: 'geist-mono', name: 'Geist Mono' },
  { id: 'commit', name: 'Commit Mono' },
];

const hands = [
  { id: 'radon', name: 'Monaspace Radon' },
  { id: 'casual', name: 'Recursive Casual' },
  { id: 'excalifont', name: 'Excalifont' },
];

const directions = [
  {
    id: 'workbench',
    name: 'A · Workbench',
    note: 'After DialKit and Josh Puckett. Quiet and precise: rank by ink, figures as flat wells, and the dials around the title really set this canvas. Press one.',
  },
  {
    id: 'field',
    name: 'B · Field guide',
    note: 'After Ciechanowski and Josh Comeau. The prose names each switch in the colour it turns on; one hand-written note at the first thing to try; a tick for each block in the margin, the one you are reading marked.',
  },
] as const;

// Field guide's colour schemes: a palette, and the three legend colours set in the stylesheet.
const schemes = [
  { id: 'ink', name: 'Ink' },
  { id: 'blue', name: 'Blue' },
  { id: 'petrol', name: 'Petrol' },
  { id: 'mono', name: 'Mono' },
];

---

<Base title="Directions">
  <meta name="robots" content="noindex" slot="head" />
  <div class={s.lab} data-faces="jetbrains" data-hand="radon">
    <div class={s.bar}>
      <div class={s.faces} role="group" aria-label="Title face">
        {
          faces.map((f, i) => (
            <button type="button" data-face={f.id} aria-pressed={i === 0 ? "true" : "false"}>
              {f.name}
            </button>
          ))
        }
      </div>
      <div class={s.faces} role="group" aria-label="Hand">
        {
          hands.map((h, i) => (
            <button type="button" data-hand-pick={h.id} aria-pressed={i === 0 ? "true" : "false"}>
              {h.name}
            </button>
          ))
        }
      </div>
    </div>
    {
      directions.map((d) => (
        <section class={s.dir} data-direction={d.id} data-palette={d.id === 'field' ? 'ink' : undefined} data-scheme={d.id === 'field' ? 'ink' : undefined}>
          <header class={s.meta}>
            <h2>{d.name}</h2>
            <p>{d.note}</p>
            {d.id === 'field' && (
              <div class={`${s.faces} ${s.schemes}`} role="group" aria-label="Colour scheme">
                {schemes.map((c, i) => (
                  <button type="button" data-scheme-pick={c.id} aria-pressed={i === 0 ? "true" : "false"}>
                    {c.name}
                  </button>
                ))}
              </div>
            )}
          </header>
          <div class={s.canvas} data-canvas>
            <Heads direction={d.id} />
            {d.id === 'field' && (
              <nav class={s.rail} aria-label="On this page">
                <div class={s.ticks} data-ticks>
                  <div class={s.peek} data-peek aria-hidden="true">
                    <b />
                    <span />
                  </div>
                </div>
              </nav>
            )}
            <article class={s.page}>
              <Opening keyed={d.id === 'field'}>
                {d.id === 'field' && (
                  <span slot="note" class={s.hand} style="right: 48px; top: -14px" aria-hidden="true" data-note="[role=switch]">
                    flip one a few times
                  </span>
                )}
              </Opening>
            </article>
          </div>
        </section>
      ))
    }
  </div>
  <script>
    import '../../components/directions/lab';
    import '../../components/directions/ticks';
    import '../../components/directions/notes';
  </script>
</Base>
