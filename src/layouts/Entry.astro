---
// Layout for every component and principle page. The MDX body supplies the
// sections; this frame supplies the way back and the way on.
import Base from './Base.astro';
import { entries, href, titleIn, summaryIn } from '../entries';
import { langOf, linkIn, ui } from '../i18n';
import { BackIcon } from '../ui/icons';
import s from './Entry.module.scss';

const { frontmatter } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
const i = entries.findIndex((e) => e.slug === frontmatter.slug);
const entry = entries[i];
const prev = entries[i - 1];
const next = entries[i + 1];
const back = { component: t.allComponents, principle: t.allPrinciples, practice: t.allPractice }[entry.kind];
// The pager says when the next page is in another section, so crossing over isn't a surprise.
const kindName = { component: t.component, principle: t.principle, practice: t.practice };
const kind = kindName[entry.kind];
---

<Base title={titleIn(entry, lang)} description={summaryIn(entry, lang)}>
  <article class={s.page}>
    {/* Back to this entry's own section of the index, not the top of it. */}
    <a class={s.back} href={`${lang === 'zh' ? '/zh' : '/'}#${entry.kind}`}>
      <BackIcon />
      {back}
    </a>
    <header class={s.head}>
      <p class={s.kind}>{kind}</p>
      <h1 class={s.title}>{titleIn(entry, lang)}</h1>
      <p class={s.summary}>{summaryIn(entry, lang)}</p>
    </header>
    <div class={s.body}>
      <slot />
    </div>
    <nav class={s.pager} aria-label={t.more}>
      {
        prev && (
          <a class={s.next} href={linkIn(href(prev), lang)} rel="prev">
            <span class={s.nextLabel}>
              {t.previous}
              {prev.kind !== entry.kind && ` · ${kindName[prev.kind]}`}
            </span>
            <span class={s.nextTitle}>{titleIn(prev, lang)}</span>
          </a>
        )
      }
      {
        next && (
          <a class={`${s.next} ${s.forward}`} href={linkIn(href(next), lang)} rel="next">
            <span class={s.nextLabel}>
              {t.next}
              {next.kind !== entry.kind && ` · ${kindName[next.kind]}`}
            </span>
            <span class={s.nextTitle}>{titleIn(next, lang)}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
